# Copy to .env.local and fill in your own Supabase project values.
# Dashboard -> Project Settings -> API
#
# Only the public ANON key ever goes here. NEVER put the service_role key or any
# other secret in a VITE_* variable: everything prefixed VITE_ is shipped to the browser.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Optional
# Show a "continue with Google" button (requires enabling the Google provider in Supabase Auth).
VITE_GOOGLE_AUTH=false
# Use a language model (Supabase Edge Function "assistant") to understand chat messages.
# Off by default: the built-in Egyptian-Arabic parser works without it.
VITE_ASSISTANT_AI=false
# Contact email shown in the landing-page footer (leave empty to hide it).
VITE_CONTACT_EMAIL=
